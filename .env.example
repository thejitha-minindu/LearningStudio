# Copy to .env in the repository root for Docker Compose.
# For local Python commands, copy this file to backend/.env instead.
PROVIDER_MODE=fixture
DEV_API_TOKEN=local-development-only
DATABASE_URL=postgresql+psycopg://learning:learning@db:5432/learning
# For local execution without Docker: DATABASE_URL=sqlite:///./learning.db
GEMINI_API_KEY=
# Example model; availability and free-tier quotas depend on your Google AI Studio account.
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
MAX_SEARCHES=3
MAX_PAGES=6
MAX_DOWNLOAD_BYTES=5000000
MAX_PDF_PAGES=80
REQUEST_TIMEOUT=20
RETRIES=2
CACHE_SECONDS=86400
RATE_LIMIT_PER_MINUTE=120
JOB_MAX_ATTEMPTS=3
MAX_OUTPUT_TOKENS=6000
# Optional development-only absolute directory; blank disables all local paths.
ALLOWED_RESOURCE_DIR=
CORS_ORIGINS=http://localhost:3000
